# ── required ────────────────────────────────────────────────────────────────
# 32 random bytes, base64. Encrypts server-side secrets at rest.
# Losing it makes the database unusable. Generate: openssl rand -base64 32
TERMOSO_MASTER_KEY=

# Public URL of the server. The image serves both the API (/api/v1) and the web
# cabinet (/) on this origin.
TERMOSO_PUBLIC_URL=https://termoso.example.com
# Origin of the web cabinet (links in e-mails, redirects from the landing).
# Defaults to TERMOSO_PUBLIC_URL; set it only when the cabinet is hosted elsewhere.
#TERMOSO_WEB_URL=https://app.termoso.example.com

# Landing page on `/`. Three layouts:
#   1. default — landing and cabinet share TERMOSO_PUBLIC_URL (`/` = landing).
#   2. TERMOSO_LANDING=false — no landing; `/` goes straight to /login.
#   3. TERMOSO_LANDING_URL=https://termoso.example.com with
#      TERMOSO_PUBLIC_URL=TERMOSO_WEB_URL=https://app.termoso.example.com —
#      the landing on the apex domain, cabinet + API on the subdomain. Point
#      both names at this server; on the landing host only `/` and the static
#      files are served, every other path redirects to the cabinet.
#TERMOSO_LANDING=true
#TERMOSO_LANDING_URL=https://termoso.example.com
# Optional dedicated origin for SSH ID: point its DNS at the same server and
# handles are served at the root (https://sshid.termoso.example.com/<handle>,
# /<handle>/RSA, /<handle>/all) with no API or cabinet on that host.
# Unset = https://termoso.example.com/sshid/<handle> (always available).
#TERMOSO_SSHID_URL=https://sshid.termoso.example.com

# ── stack (docker-compose.yml / quadlet) ────────────────────────────────────
POSTGRES_PASSWORD=change-me
RUSTFS_ACCESS_KEY=termoso
RUSTFS_SECRET_KEY=change-me-too
#S3_BUCKET=termoso-logs

# Public origin clients use for pre-signed session-log uploads/downloads.
# Your reverse proxy forwards it to rustfs:9000. Required for session logs.
TERMOSO_S3__PUBLIC_ENDPOINT=https://s3.termoso.example.com

# Alternative to S3: keep the (client-encrypted) session logs on the server's
# disk. Mount a volume at this path; clients download through short-lived
# tokens on /api/v1/logs/blob. Takes precedence over TERMOSO_S3__* when set.
#TERMOSO_LOGS_DIR=/var/lib/termoso/logs

# Image tag (a release like 0.2.0, or latest) and where published ports bind.
# 127.0.0.1 keeps everything private until a reverse proxy is in front; use
# 0.0.0.0 only if the proxy runs on another machine.
TERMOSO_VERSION=latest
TERMOSO_LISTEN=127.0.0.1
TERMOSO_PORT=8080
#RUSTFS_PORT=9000
#RUSTFS_CONSOLE_PORT=9001

# `--profile proxy`: Caddy with automatic TLS. Both names must resolve to this
# host; TERMOSO_S3_DOMAIN must equal the host in TERMOSO_S3__PUBLIC_ENDPOINT.
# TERMOSO_DOMAIN takes a comma-separated list when the landing (or SSH ID)
# has its own hostname, e.g. `app.termoso.example.com, termoso.example.com`.
#TERMOSO_DOMAIN=termoso.example.com
#TERMOSO_S3_DOMAIN=s3.termoso.example.com
#ACME_EMAIL=you@example.com

# `--profile bridge`: API Bridge. Credentials file from the cabinet
# (Account → API Bridge) and a shared secret callers must present.
#TERMOSO_BRIDGE_CREDENTIALS_FILE=./bridge.json
#TERMOSO_BRIDGE_API_KEY=
#TERMOSO_BRIDGE_PORT=8081
#TERMOSO_BRIDGE_SYNC_INTERVAL=60

# ── recommended ─────────────────────────────────────────────────────────────
# Comma-separated e-mails that become administrators on sign-up / login.
TERMOSO_ADMIN_EMAILS=you@example.com
TERMOSO_SERVER_NAME=Termoso
# Extra comma-separated browser origins allowed to call the API. Not needed when
# the cabinet is served by the server itself.
#TERMOSO_CORS_ORIGINS=https://app.termoso.example.com

# SMTP (e-mail verification, device approval, e-mail MFA). Omit to run without e-mail.
TERMOSO_SMTP__HOST=smtp.example.com
TERMOSO_SMTP__PORT=587
TERMOSO_SMTP__USERNAME=
TERMOSO_SMTP__PASSWORD=
TERMOSO_SMTP__SECURITY=starttls
TERMOSO_SMTP__FROM=Termoso <no-reply@termoso.example.com>

# WebAuthn / passkeys (optional).
TERMOSO_WEBAUTHN__RP_ID=termoso.example.com
TERMOSO_WEBAUTHN__ORIGINS=https://termoso.example.com,tauri://localhost,http://tauri.localhost

# ── optional ────────────────────────────────────────────────────────────────
# Android App Links: lets the Termoso Android app open this server's
# https://…/invite/<token> and /join/<id> links directly. Comma-separated
# <package>=<SHA-256 signing-certificate fingerprint>; served as
# /.well-known/assetlinks.json. Fingerprint: keytool -list -v … | grep SHA256
#TERMOSO_ANDROID_APP_LINKS=com.termoso.android=AA:BB:CC:…

# SSO (OIDC). Presets: google, microsoft, github. Any other slug needs ISSUER.
#TERMOSO_SSO__GOOGLE__CLIENT_ID=
#TERMOSO_SSO__GOOGLE__CLIENT_SECRET=
#TERMOSO_SSO__GITHUB__CLIENT_ID=
#TERMOSO_SSO__GITHUB__CLIENT_SECRET=
#TERMOSO_SSO__COMPANY__NAME=Company SSO
#TERMOSO_SSO__COMPANY__ISSUER=https://login.example.com/realms/main
#TERMOSO_SSO__COMPANY__CLIENT_ID=
#TERMOSO_SSO__COMPANY__CLIENT_SECRET=
#TERMOSO_SSO__COMPANY__ALLOWED_DOMAINS=example.com
# SSO (SAML 2.0). Register the SP at <TERMOSO_PUBLIC_URL>/api/v1/auth/sso/corp/saml/metadata
# with your IdP; the ACS is <TERMOSO_PUBLIC_URL>/api/v1/auth/sso/saml/acs (HTTP-POST).
# SAML_METADATA is a URL, a file path or inline XML. The SP certificate/key
# (PEM or paths) enable signed AuthnRequests and encrypted assertions;
# SAML_SIGN_REQUESTS defaults to what the IdP metadata asks for. Email/name
# attributes default to mail/email/OID/WS-Fed claims or an email NameID.
#TERMOSO_SSO__CORP__NAME=Corp SAML
#TERMOSO_SSO__CORP__KIND=saml
#TERMOSO_SSO__CORP__SAML_METADATA=https://idp.example.com/metadata
#TERMOSO_SSO__CORP__SAML_IDP_ENTITY_ID=
#TERMOSO_SSO__CORP__SAML_SP_CERTIFICATE=/run/secrets/saml-sp.crt
#TERMOSO_SSO__CORP__SAML_SP_PRIVATE_KEY=/run/secrets/saml-sp.key
#TERMOSO_SSO__CORP__SAML_SIGN_REQUESTS=
#TERMOSO_SSO__CORP__SAML_ALLOW_SHA1=false
#TERMOSO_SSO__CORP__SAML_EMAIL_ATTRIBUTE=
#TERMOSO_SSO__CORP__SAML_NAME_ATTRIBUTE=
#TERMOSO_SSO__CORP__SAML_CLOCK_SKEW_SECS=120
#TERMOSO_SSO__CORP__ALLOWED_DOMAINS=example.com

# AI command suggestions (optional; unset = feature absent). Users still have
# to opt in per account. Only the typed request + OS/shell label is sent; the
# key, prompts and answers are never logged. Defaults target Chutes' TEE model
# (confidential compute — not end-to-end encryption). Any OpenAI-compatible
# endpoint works: set URL/MODEL and CONFIDENTIAL=false for a plain one.
#TERMOSO_AI__API_KEY=
#TERMOSO_AI__URL=https://llm.chutes.ai/v1
#TERMOSO_AI__MODEL=GLM-4.7-Flash-NVFP4-TEE
#TERMOSO_AI__PROVIDER=Chutes
#TERMOSO_AI__CONFIDENTIAL=true
#TERMOSO_AI__DAILY_QUOTA=50
#TERMOSO_AI__MAX_PROMPT_CHARS=500
#TERMOSO_AI__TIMEOUT_SECS=30

# Operator-only Prometheus metrics on a separate private listener. Off by default.
#TERMOSO_METRICS__ENABLED=true
#TERMOSO_METRICS__BIND=127.0.0.1:9090

TERMOSO_LOG=info,sqlx=warn
TERMOSO_LOG_FORMAT=json
# Swagger UI at /api/docs and the OpenAPI document at /api/openapi.json.
TERMOSO_SWAGGER_UI=false
# Documentation at /docs (part of the web cabinet bundle). TERMOSO_DOCS=false hides
# it; TERMOSO_DOCS_URL gives it its own origin (https://docs.example.com) — the
# landing and cabinet then redirect /docs there. Needs TERMOSO_WEB_DIR.
#TERMOSO_DOCS=true
#TERMOSO_DOCS_URL=
# API bridges (Account → API Bridge, bridge tokens). Default true; the hosted
# cloud runs with false, which hides the page and rejects bridge tokens.
#TERMOSO_BRIDGES=true
# PostgreSQL pool size per API replica.
#TERMOSO_DATABASE_MAX_CONNECTIONS=20
# Prefix for all Redis keys/channels (only needed if deployments share one Redis).
#TERMOSO_REDIS_PREFIX=termoso:
# Waiting period (seconds) of the "Start over" account reset. Default 24 h.
#TERMOSO_START_OVER_DELAY_SECS=86400
